---
// Join card component with the two real resolver IPs
---

<div class="join-card">
  <h2>Join Cutline</h2>
  <p>Configure your device or router to use these DNS resolvers:</p>
  
  <div class="resolver-ips">
    <div class="ip-box">
      <code class="ip">64.176.200.99</code>
      <button class="copy-btn" data-ip="64.176.200.99">Copy</button>
    </div>
    <div class="ip-box">
      <code class="ip">149.28.79.49</code>
      <button class="copy-btn" data-ip="149.28.79.49">Copy</button>
    </div>
  </div>

  <div class="quick-steps">
    <h3>Quick Start</h3>
    <ul>
      <li>Router: Set custom DNS if your ISP allows</li>
      <li>macOS: System Settings → Network → DNS Servers</li>
      <li>iPhone: Settings → Wi-Fi → Configure DNS → Manual</li>
      <li>Windows: Network Settings → Change adapter options → DNS</li>
      <li>Android: Settings → Network → Private DNS</li>
    </ul>
    <a href="/get-on" class="setup-link">Full setup guides →</a>
  </div>

  <div class="profile-card">
    <h3>Apple Configuration Profile</h3>
    <p class="coming-soon">Coming soon</p>
    <p class="helper-text">A downloadable profile for easy iOS/macOS setup</p>
  </div>

  <div class="domain-info">
    <p><strong>Domain:</strong> thecutline.org (registered, HTTPS/DoH not live yet)</p>
  </div>
</div>

<style>
  .join-card {
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--spacing-xl);
    margin: var(--spacing-xl) 0;
  }

  .join-card h2 {
    margin-top: 0;
    color: var(--color-text);
  }

  .resolver-ips {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-md);
    margin: var(--spacing-lg) 0;
  }

  .ip-box {
    background: var(--color-bg);
    border: 2px solid var(--color-accent);
    border-radius: var(--radius);
    padding: var(--spacing-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm);
  }

  .ip {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-accent);
    background: none;
  }

  .copy-btn {
    background: var(--color-accent);
    color: white;
    border: none;
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.2s;
  }

  .copy-btn:hover {
    background: var(--color-accent-hover);
  }

  .copy-btn:active {
    transform: scale(0.95);
  }

  .quick-steps {
    margin: var(--spacing-xl) 0;
    padding: var(--spacing-md);
    background: var(--color-bg);
    border-radius: var(--radius);
  }

  .quick-steps h3 {
    margin-top: 0;
    font-size: 1.1rem;
  }

  .quick-steps ul {
    margin: var(--spacing-md) 0;
    padding-left: var(--spacing-lg);
  }

  .quick-steps li {
    margin-bottom: var(--spacing-xs);
    color: var(--color-text-muted);
  }

  .setup-link {
    display: inline-block;
    margin-top: var(--spacing-sm);
    font-weight: 500;
  }

  .profile-card {
    margin: var(--spacing-lg) 0;
    padding: var(--spacing-md);
    background: var(--color-bg);
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }

  .profile-card h3 {
    margin-top: 0;
    font-size: 1.1rem;
  }

  .coming-soon {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: #f0f0f0;
    color: var(--color-text-muted);
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: var(--spacing-sm);
  }

  .helper-text {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 0;
  }

  .domain-info {
    margin-top: var(--spacing-lg);
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .domain-info p {
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .join-card {
      padding: var(--spacing-md);
    }

    .resolver-ips {
      grid-template-columns: 1fr;
    }

    .ip-box {
      flex-direction: column;
      text-align: center;
    }

    .copy-btn {
      width: 100%;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const copyButtons = document.querySelectorAll('.copy-btn');
    
    copyButtons.forEach(button => {
      button.addEventListener('click', async () => {
        const ip = button.getAttribute('data-ip');
        if (ip) {
          try {
            await navigator.clipboard.writeText(ip);
            const originalText = button.textContent;
            button.textContent = 'Copied!';
            setTimeout(() => {
              button.textContent = originalText;
            }, 2000);
          } catch (err) {
            console.error('Failed to copy:', err);
          }
        }
      });
    });
  });
</script>
