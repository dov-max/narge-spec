<script>
  // Tab switching functionality
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.tab');
    const panels = document.querySelectorAll('.tab-panel');

    function switchTab(targetId: string) {
      tabs.forEach(tab => {
        const isTarget = tab.getAttribute('aria-controls') === targetId;
        tab.classList.toggle('active', isTarget);
        tab.setAttribute('aria-selected', isTarget ? 'true' : 'false');
      });

      panels.forEach(panel => {
        panel.classList.toggle('active', panel.id === targetId);
      });
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('aria-controls');
        if (targetId) switchTab(targetId);
      });

      tab.addEventListener('keydown', (e: KeyboardEvent) => {
        const currentIndex = Array.from(tabs).indexOf(tab);
        let newIndex = currentIndex;

        if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          newIndex = currentIndex > 0 ? currentIndex - 1 : tabs.length - 1;
        } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          newIndex = currentIndex < tabs.length - 1 ? currentIndex + 1 : 0;
        } else if (e.key === 'Home') {
          e.preventDefault();
          newIndex = 0;
        } else if (e.key === 'End') {
          e.preventDefault();
          newIndex = tabs.length - 1;
        } else {
          return;
        }

        const newTab = tabs[newIndex] as HTMLElement;
        const targetId = newTab.getAttribute('aria-controls');
        if (targetId) {
          switchTab(targetId);
          newTab.focus();
        }
      });
    });

    // Fetch stats for both locations
    async function fetchStats() {
      const locations = ['ewr', 'lax'];
      
      for (const loc of locations) {
        try {
          const response = await fetch(`https://${loc}.dns.thecutline.org/stats.json`);
          if (!response.ok) throw new Error('Failed to fetch');
          
          const data = await response.json();
          
          // Update health
          const healthEl = document.querySelector(`[data-stat="${loc}-health"]`);
          if (healthEl) {
            if (data.health === 'healthy') {
              healthEl.textContent = '✓ Healthy';
            } else if (data.health === 'degraded') {
              healthEl.textContent = '⚠ Degraded';
            } else if (data.health === 'down') {
              healthEl.textContent = '✗ Down';
            } else {
              healthEl.textContent = '—';
            }
          }
          
          // Update IPs
          const ipsEl = document.querySelector(`[data-stat="${loc}-ips"]`);
          if (ipsEl && data.distinct_ips_7d !== undefined) {
            ipsEl.textContent = String(data.distinct_ips_7d);
          }
          
          // Update p50
          const p50El = document.querySelector(`[data-stat="${loc}-p50"]`);
          if (p50El && data.latency?.p50_ms !== undefined) {
            p50El.textContent = `${data.latency.p50_ms.toFixed(1)} ms`;
          }
          
          // Update p95
          const p95El = document.querySelector(`[data-stat="${loc}-p95"]`);
          if (p95El && data.latency?.p95_ms !== undefined) {
            p95El.textContent = `${data.latency.p95_ms.toFixed(1)} ms`;
          }
        } catch (e) {
          // Fail closed - keep dashes
        }
        
        // Fetch history
        try {
          const historyResponse = await fetch(`https://${loc}.dns.thecutline.org/history.jsonl`);
          if (!historyResponse.ok) throw new Error('Failed to fetch history');
          
          const text = await historyResponse.text();
          const lines = text.trim().split('\n').slice(-30);
          
          if (lines.length > 0) {
            const historySection = document.getElementById(`${loc}-history`);
            const historyBody = document.getElementById(`${loc}-history-body`);
            
            if (historySection && historyBody) {
              historyBody.innerHTML = '';
              
              lines.forEach(line => {
                try {
                  const entry = JSON.parse(line);
                  const row = document.createElement('tr');
                  
                  const dateCell = document.createElement('td');
                  dateCell.textContent = entry.date || '—';
                  row.appendChild(dateCell);
                  
                  const ipsCell = document.createElement('td');
                  ipsCell.textContent = entry.distinct_ips_7d !== undefined ? String(entry.distinct_ips_7d) : '—';
                  row.appendChild(ipsCell);
                  
                  const latencyCell = document.createElement('td');
                  latencyCell.textContent = entry.latency !== undefined ? `${entry.latency.toFixed(1)} ms` : '—';
                  row.appendChild(latencyCell);
                  
                  historyBody.appendChild(row);
                } catch (e) {
                  // Skip malformed lines
                }
              });
              
              historySection.style.display = 'block';
            }
          }
        } catch (e) {
          // Fail closed - no history
        }
      }
    }

    // Fetch on load
    fetchStats();
    
    // Refresh every 5 minutes
    setInterval(fetchStats, 5 * 60 * 1000);
  });
</script>
